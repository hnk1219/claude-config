{
  "permissions": {
    "allow": [
      "mcp__ccd_session_mgmt__set_session_title",
      "Bash(cp *)",
      "Bash(python3 *)",
      "Bash(git *)"
    ],
    "additionalDirectories": [
      "D:\\codeWork",
      "G:\\マイドライブ",
      "C:\\Users\\__USERNAME__\\Documents\\maya\\scripts",
      "C:\\Users\\__USERNAME__\\.claude\\projects\\D--hnk-scripts\\memory",
      "C:\\Users\\__USERNAME__\\.claude\\CLAUDE.md",
      "C:\\Users\\__USERNAME__\\.claude\\settings.json",
      "C:\\Users\\__USERNAME__\\.claude\\access-attempts.log"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\__USERNAME__\\.claude-mem\\sync\\pull.ps1\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\__USERNAME__\\.claude\\hooks\\session_title_icon.ps1\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\__USERNAME__\\.claude-mem\\sync\\push.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\__USERNAME__\\.claude\\hooks\\block_bash_outside.ps1\""
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\__USERNAME__\\.claude\\hooks\\log_access.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\__USERNAME__\\.claude\\statusline.ps1\""
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true
  },
  "theme": "dark",
  "agentPushNotifEnabled": true
}